# =============================================================================
# NetIntel AI — Environment Configuration Template
# =============================================================================
#
# This file is a TEMPLATE. It documents the categories of configuration the
# eventual system may require. Values below are placeholders only — never
# real credentials.
#
# Local, real secrets belong in a file named `.env` (or another `.env.*`
# variant), which is git-ignored and must never be committed. Copy this file
# to `.env` and fill in your own local values:
#
#   cp .env.example .env
#
# The specific technology choices behind each category below have not yet
# been finalized — this template is intentionally technology-neutral during
# the pre-setup / foundation phase.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# APP_ENV separates configuration profiles: "development" (local, default),
# "demo" (rehearsed/presentation runs), "production" (not a target for this
# hackathon demo, but kept as a distinct value rather than reused for demo).
APP_ENV=development
APP_SECRET=
APP_PORT=

# -----------------------------------------------------------------------------
# AI / LLM Provider
# -----------------------------------------------------------------------------
# Optional at application startup — the app runs without this set (see
# src/lib/ai/client.ts). Required only once a call to the AI layer is
# actually made (extraction, entity-resolution adjudication, Copilot —
# none implemented yet). Never a real key in this file; set it in your
# local, git-ignored .env.
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# SQLite file path (via Node's built-in node:sqlite + Drizzle). Defaults to
# ./data/netintel.db if unset — see src/lib/env.ts. The data/ directory is
# git-ignored local runtime state, never committed.
DATABASE_URL=./data/netintel.db

# -----------------------------------------------------------------------------
# Search / Vector Store
# -----------------------------------------------------------------------------
VECTOR_STORE_URL=
VECTOR_STORE_API_KEY=

# -----------------------------------------------------------------------------
# Maps / Geospatial Provider
# -----------------------------------------------------------------------------
MAP_PROVIDER_API_KEY=

# -----------------------------------------------------------------------------
# Object / Evidence Storage
# -----------------------------------------------------------------------------
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# -----------------------------------------------------------------------------
# Development Configuration
# -----------------------------------------------------------------------------
LOG_LEVEL=info
