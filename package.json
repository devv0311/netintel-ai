{
  "name": "cipher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CIPHER — synthetic-data investigative intelligence platform (application foundation)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "corpus:generate": "node --import ./scripts/ts-resolve.mjs scripts/generate-corpus.ts",
    "evaluate": "node --import ./scripts/eval-resolve.mjs scripts/evaluate.ts",
    "collect:public": "node --use-env-proxy --import ./scripts/eval-resolve.mjs scripts/collect-public.ts",
    "fixture:morphology": "node --import ./scripts/eval-resolve.mjs scripts/build-morphology-fixture.ts",
    "experiment:generalisation": "node --import ./scripts/eval-resolve.mjs scripts/generalisation-experiment.ts",
    "ml:dataset": "node --import ./scripts/eval-resolve.mjs scripts/ml/build-pair-dataset.ts",
    "ml:leakage": "node --import ./scripts/eval-resolve.mjs scripts/ml/leakage-audit.ts",
    "ml:train": "node --import ./scripts/eval-resolve.mjs scripts/ml/train-model.ts",
    "ml:evaluate": "node --import ./scripts/eval-resolve.mjs scripts/ml/evaluate-model.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.123.0",
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "1.0.0-rc.5-169397b",
    "graphology": "0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "graphology-metrics": "^2.4.2",
    "graphology-shortest-path": "^2.1.0",
    "lucide-react": "1.39.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sigma": "^3.0.3",
    "tailwind-merge": "3.6.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
